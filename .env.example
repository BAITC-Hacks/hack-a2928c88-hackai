# No key is required for the explicit local mock scenario.
MOCK=1
FALLBACK_TO_MOCK=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
# Leave empty until you receive a key. Never send keys to the browser or Git.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
MAX_CALLS_PER_HOUR=100
AI_TIMEOUT_SECONDS=45
SPEC_TIMEOUT_SECONDS=90
DATABASE_PATH=data/runtime/sana.sqlite3
SEED_DEMO=1
# Explicit demo identity picker for questions and project letters. Disable for deployment behind real authentication.
COMMUNITY_DEMO=1
# Canonical origin encoded in recommendation PDF QR links (set to deployed HTTPS URL).
APP_PUBLIC_URL=http://127.0.0.1:8000
