# Скопировать в .env. .env НЕ коммитить.
OPENAI_API_KEY=
# Проверить доступные модели на площадке: python scripts/check_openai.py
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_STRONG=gpt-5.5
# 1 = без вызова модели (демо/тесты/нет сети)
MOCK=0
# при сбое API вернуть mock вместо 500
FALLBACK_TO_MOCK=1
APP_NAME=HackAlem Project
